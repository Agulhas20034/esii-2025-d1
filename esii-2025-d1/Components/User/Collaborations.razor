@page "/user/collaborations"
@inject HttpClient Http
@inject IInvitationService InvitationService

@using BlazorBootstrap

@using esii_2025_d1.Dtos.ProjectDtos
@using esii_2025_d1.Dtos.AssignmentDtos
@using esii_2025_d1.Dtos.ProjectUserDtos
@using esii_2025_d1.Dtos.UserInfoDtos
@using esii_2025_d1.Dtos.UserDtos
@using esii_2025_d1.ViewModels
@using esii_2025_d1.Models
@using esii_2025_d1.Interfaces.Invitations

@* // acrecentado para obter userID (user em geral) *@
@using esii_2025_d1.Data;
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using esii_2025_d1.Services
@using System.Security.Claims
@inject UserManager<ApplicationUser> AspNetUserManager;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject RoleManager<IdentityRole> RoleManager
@inject SingletonUserManager UserManager
@* // acrecentado para obter userID (user em geral) *@
@rendermode InteractiveServer

<div>
    <Tabs EnableFadeEffect="true" TabChanged="OnTabChanged">
        <Tab Active="true">
            <TitleTemplate>
                <Icon Name="IconName.Passport" /> Projects
            </TitleTemplate>
            <Content>
                <div>
                    <Grid TItem="Project"
                    Class="table table-hover table-bordered table-striped"
                    Data="@projects"
                    AllowPaging="true"
                    PageSize="10"
                    AllowSorting="true"
                    AllowSelection="false"
                    SelectionMode="GridSelectionMode.Multiple"
                    Responsive="true">

                        <GridColumns>
                            <GridColumn TItem="Project" HeaderText="Name"  SortKeySelector="item => item.Name">
                                @context?.Name
                            </GridColumn>
                            <GridColumn TItem="Project" HeaderText="Description" SortKeySelector="item => item.Description">
                                @context?.Description
                            </GridColumn>
                            <GridColumn TItem="Project" HeaderText="Hourly Rate"  SortKeySelector="item => item.HourlyRate">
                                @context?.HourlyRate
                            </GridColumn>
                        </GridColumns>
                    </Grid>
                </div>
            </Content>
        </Tab>
        <Tab>
            <TitleTemplate>
                <Icon Name="IconName.Pass" /> Assignments
            </TitleTemplate>
            <Content>
                <div>
                    <h5>
                        Total Time Spent:
                        @($"{totalSpentTime.Days} days, {totalSpentTime.Hours} hours, {totalSpentTime.Minutes} minutes")
                    </h5>
                    <Grid TItem="Assignment"
                    Class="table table-hover table-bordered table-striped"
                    Data="@assignments"
                    AllowPaging="true"
                    PageSize="10"
                    AllowSorting="true"
                    AllowSelection="false"
                    SelectionMode="GridSelectionMode.Multiple"
                    Responsive="true">

                        <GridColumns>
                            <GridColumn TItem="Assignment" HeaderText="Description"  SortKeySelector="item => item.Description">
                                @context?.Description
                            </GridColumn>
                            <GridColumn TItem="Assignment" HeaderText="Hourly Rate" SortKeySelector="item => item.HourlyRate">
                                @context?.HourlyRate
                            </GridColumn>
                            <GridColumn TItem="Assignment" HeaderText="Start Date"  SortKeySelector="item => item.StartDate">
                                @context?.StartDate
                            </GridColumn>
                            <GridColumn TItem="Assignment" HeaderText="End Date"  SortKeySelector="item => item.EndDate">
                                @context?.EndDate
                            </GridColumn>
                        </GridColumns>
                    </Grid>
                </div>
            </Content>
        </Tab>
        <Tab Id="invitations">
            <TitleTemplate>
                <Icon Name="IconName.PersonFill" /> Invitations
            </TitleTemplate>
            <Content>
                <div>
                    <Grid TItem="Invitation"
                    Class="table table-hover table-bordered table-striped"
                    Data="@invitations"
                    AllowPaging="true"
                    PageSize="10"
                    AllowSorting="true"
                    AllowSelection="false"
                    SelectionMode="GridSelectionMode.Multiple"
                    Responsive="true">

                        <GridColumns>
                            <GridColumn TItem="Invitation" HeaderText="Inviter"  SortKeySelector="item => item.userInfo.Name">
                                @context.userInfo?.Name
                            </GridColumn>
                            <GridColumn TItem="Invitation" HeaderText="Project Name" SortKeySelector="item => item.project.Name">
                                @context.project?.Name
                            </GridColumn>
                            <GridColumn TItem="Invitation" HeaderText="Project Description"  SortKeySelector="item => item.project.Description">
                                @context.project?.Description
                            </GridColumn>
                            <GridColumn TItem="Invitation" HeaderText="Hourly Rate"  SortKeySelector="item => item.project.HourlyRate">
                                @context.project?.HourlyRate
                            </GridColumn>
                            <GridColumn TItem="Invitation" HeaderText="Actions">
                                <button class="btn btn-success btn-sm" @onclick="() => ConfirmAcceptInvitation(context)">
                                    <Icon Name="IconName.Check2Circle" /> Accept
                                </button>
                                <button class="btn btn-warning btn-sm" @onclick="() => ConfirmRejectInvitation(context)">
                                    <Icon Name="IconName.XCircle" /> Reject
                                </button>
                            </GridColumn>
                        </GridColumns>
                    </Grid>
                </div>
            </Content>
        </Tab>
    </Tabs>
</div> 

<!-- Modal Accept Invite -->
<Modal @ref="confirmAcceptInviteModal" Title="Confirm Action" ModalType="ModalType.Success">
    <BodyTemplate>
        <p>You are about to accept @pendingInvite.userInfo.Name's request to join project "@pendingInvite.project.Name".</p>

    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="() => confirmAcceptInviteModal.HideAsync()">Cancel</Button>
        <Button Color="ButtonColor.Success" @onclick="AcceptInvitation">Accept Request</Button>
    </FooterTemplate>
</Modal>

<!-- Modal Reject Invite -->
<Modal @ref="confirmRejectInviteModal" Title="Confirm Action" ModalType="ModalType.Warning">
    <BodyTemplate>
        <p>You are about to reject @pendingInvite.userInfo.Name's request to join project "@pendingInvite.project.Name".</p>

    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="() => confirmRejectInviteModal.HideAsync()">Cancel</Button>
        <Button Color="ButtonColor.Warning" @onclick="RejectInvitation">Cancel Request</Button>
    </FooterTemplate>
</Modal>

@code {

    @* // acrecentado para obter userID (user em geral) *@
    UserInfo? currentUser;
    private List<UserWithRoles> users = new();
    private string? currentUserId;

    public class UserWithRoles
    {
        public ApplicationUser User { get; set; }
        public List<string> RoleNames { get; set; } = new();
    }
    @* // acrecentado para obter userID (user em geral) *@

    List<ToastMessage> messages = [];

    private Modal confirmAcceptInviteModal = default!;
    private Modal confirmRejectInviteModal = default!;


    private List<Invitation> invitations = new();
    private Invitation pendingInvite = new();

    private List<Project> projects = new();
    private List<Assignment> assignments = new();

    TimeSpan totalSpentTime = TimeSpan.Zero;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        await LoadUsersWithRoles();

        try
        {
            var response = await Http.GetFromJsonAsync<List<UserFullResponseDto>>("api/user");
            //var info = response ?? new List<UserInfoResponseDto>();
            var userExists = response.FirstOrDefault(a => a?.UserInfo?.UserId == currentUserId);
            if (userExists == null)
            {
                var newUserInfo = new UserInfoCreateDto
                    {
                        UserId = currentUserId,
                        Name = authState.User.Identity.Name,
                        DailyWorkHours = 0
                    };
                var response2 = await Http.PostAsJsonAsync<UserInfoCreateDto>("api/user/info", newUserInfo);
            }

        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Erro ao buscar utilizador: {ex.Message}");
        }

        await LoadInvitations();
        await LoadProjects();
        await LoadAssignments();
    }

    @* // acrecentado para obter userID (user em geral) *@
    private async Task LoadUsersWithRoles()
    {
        var allUsers = UserManager.GetAllUsers();
        var userList = new List<UserWithRoles>();


        foreach (var user in allUsers)
        {
            var roles = await AspNetUserManager.GetRolesAsync(user);
            userList.Add(new UserWithRoles
                {
                    User = user,
                    RoleNames = roles.ToList()
                });
        }

        users = userList;
    }
    @* acrecentado para obter userID (user em geral) *@

    private async Task LoadInvitations()
    {
        invitations = await InvitationService.GetPendingInvitations(currentUserId);
    }

    private async Task OnTabChanged(Tab selectedTab)
    {
        if (selectedTab.Title == "Invitations")
        {
            await LoadInvitations();
        }
    }


    private void ShowToast(ToastType type, string message, string title) =>
    messages.Add(
    new ToastMessage
    {
        Type = type,
        Title = title,
        Content = @<div>@message <p>@DateTime.Now</p></div>,
        HelpText = $"{DateTime.Now}",
        AutoHide = true,

    });


    private void ConfirmAcceptInvitation(Invitation invitation)
    {
        pendingInvite = new Invitation
            {
                invite = invitation.invite,
                project = invitation.project,
                userInfo = invitation.userInfo
            };
        confirmAcceptInviteModal.ShowAsync();

    }

    private void ConfirmRejectInvitation(Invitation invitation)
    {
        pendingInvite = new Invitation
            {
                invite = invitation.invite,
                project = invitation.project,
                userInfo = invitation.userInfo
            };
        confirmRejectInviteModal.ShowAsync();

    }

    private async Task RejectInvitation()
    {

        var canceledInvite = new ProjectUserUpdateDto
        {
            ProjectId = pendingInvite.project.Id,
            UserId = pendingInvite.invite.UserId,
            InviterId = pendingInvite.invite.InviterId,
            Status = Models.Enums.ProjectUserStatus.Rejected
        };


        var result = await Http.PutAsJsonAsync($"api/projectuser/{pendingInvite.invite.Id}", canceledInvite);

        if (result.IsSuccessStatusCode)
        {
            await LoadInvitations();
            ShowToast(ToastType.Success, "Invitation rejected!", "Action Result");
        }
        else
        {
            ShowToast(ToastType.Warning, "It was not possible to reject the request at this time!", "Action Result");
        }
        pendingInvite = new();

        await confirmRejectInviteModal.HideAsync();

    }

    private async Task AcceptInvitation()
    {

        var acceptedInvite = new ProjectUserUpdateDto
        {
            ProjectId = pendingInvite.project.Id,
                    UserId = pendingInvite.invite.UserId,
                    InviterId = pendingInvite.invite.InviterId,
            Status = Models.Enums.ProjectUserStatus.Accepted
        };

        var result = await Http.PutAsJsonAsync($"api/projectuser/{pendingInvite.invite.Id}", acceptedInvite);

        if (result.IsSuccessStatusCode)
        {
            await LoadInvitations();
            ShowToast(ToastType.Success, "Invitation Accepted!", "Action Result");
        }
        else
        {
            ShowToast(ToastType.Warning, "It was not possible to accept the request at this time!", "Action Result");
        }
        pendingInvite = new();
        await confirmAcceptInviteModal.HideAsync();

    }

    private async Task LoadProjects()
    {
        projects.Clear();
        var response = await Http.GetFromJsonAsync<List<ProjectUser>>($"api/projectuser/byuserid/{currentUserId}");

        List<ProjectUser> items = new();

        if (response != null)
        {
            foreach (ProjectUser p in response)
            {
                if (p.Status == Models.Enums.ProjectUserStatus.Accepted) items.Add(p);
            }
        }

        var result = await Http.GetFromJsonAsync<List<Project>>("api/project");

        if (result != null)
        {
            var acceptedProjectIds = items.Select(i => i.ProjectId).ToHashSet();

            foreach (Project p in result)
            {
                if (acceptedProjectIds.Contains(p.Id))
                {
                    projects.Add(p);
                }
            }
        }

    }

    private async Task LoadAssignments()
    {
        assignments.Clear();
        try { 
            var response = await Http.GetFromJsonAsync<List<AssignmentResponseDto>>($"api/assignment/ByUserId/{currentUserId}");

            foreach (AssignmentResponseDto a in response)
            {
                assignments.Add(
                new Assignment
                {
                    Id = a.Id,
                    UserId = a.UserId,
                    ProjectId = a.ProjectId,
                    Description = a.Description,
                    HourlyRate = a.HourlyRate,
                    StartDate = a.StartDate,
                    EndDate = a.EndDate,
                    Status = a.Status
                }
                );
                if (a.StartDate.HasValue && !a.EndDate.HasValue)
                {
                    totalSpentTime += DateTime.UtcNow - a.StartDate.Value;
                }

            }
        }
        catch (Exception e)
        {
            Console.Error.WriteLine($"Exception loading assignments: {e.Message}");
        }

    }

}
