@* @page "/"
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@rendermode InteractiveServer

@inject NavigationManager Navigation
@inject Data.ApplicationDbContext DbContext

<div class="login-container">
    <h3>Login</h3>

    <EditForm Model="loginModel">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label for="Username">Username:</label>
            <InputText id="Username" @bind-Value="loginModel.Username" @onchange="@((e) => loginModel.Username = e.Value.ToString())" class="form-control" />
             <ValidationMessage For="@(() => loginModel.Username)" />
        </div>

        <div class="form-group">
            <label for="Password">Password:</label>
            <InputText id="Password" @bind-Value="loginModel.Password" @onchange="@((e) => loginModel.Password = e.Value.ToString())" type="password" class="form-control" />
            <ValidationMessage For="@(() => loginModel.Password)" />
        </div>

        <button @onclick="HandleSubmit"  class="btn btn-primary">Sign In</button>
    </EditForm>

    @if (loginFailed)
    {
        <div class="alert alert-danger mt-3">
            Invalid username or password. Please try again.
        </div>
    }

    <div>
        <p>Don't have an account? <a href="/signup">Sign Up</a></p>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private bool loginFailed = false;

    private async Task HandleSubmit(){

        var user = await DbContext.Users.FirstOrDefaultAsync(u => u.Username == loginModel.Username);

        if (user != null && user.Password.Equals(loginModel.Password)){
            Navigation.NavigateTo("/weather");
        }
        else{
            Console.WriteLine(" Invalid login credentials.");
            loginFailed = true;
        }
    }

    public class LoginModel{
        [Required(ErrorMessage = "Username is required.")]
        public string Username { get; set; }

        [Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; }

        public bool RememberMe;
    }
}
 *@