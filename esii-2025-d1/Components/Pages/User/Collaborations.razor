@page "/user/collaborations"
@inject HttpClient Http
@inject IInvitationService InvitationService

@using BlazorBootstrap

@using esii_2025_d1.Dtos.ProjectDtos
@using esii_2025_d1.Dtos.AssignmentDtos
@using esii_2025_d1.Dtos.UserInfoDtos
@using esii_2025_d1.Dtos.UserDtos
@using esii_2025_d1.ViewModels
@using esii_2025_d1.Models
@using esii_2025_d1.Interfaces.Invitations

@* // acrecentado para obter userID (user em geral) *@
@using esii_2025_d1.Data;
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using esii_2025_d1.Services
@using System.Security.Claims
@inject UserManager<ApplicationUser> AspNetUserManager;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject RoleManager<IdentityRole> RoleManager
@inject SingletonUserManager UserManager
@* // acrecentado para obter userID (user em geral) *@
@rendermode InteractiveServer

<h3>Collaborations</h3>

@if (invitations.Count == 0)
{
    <Spinner Type="SpinnerType.Dots" Class="me-3" Color="SpinnerColor.Primary" />
}
else
{
    @foreach (Invitation inv in invitations)
    {
        <p>@inv.userInfo.Name</p>
        <p>@inv.invite.InviterId</p>
        <p>@inv.project.Name</p>
    }
}


@code {

    @* // acrecentado para obter userID (user em geral) *@
    UserInfo? currentUser;
    private List<UserWithRoles> users = new();
    private string? currentUserId;

    public class UserWithRoles
    {
        public ApplicationUser User { get; set; }
        public List<string> RoleNames { get; set; } = new();
    }
    @* // acrecentado para obter userID (user em geral) *@

    List<ToastMessage> messages = [];



    private List<Invitation> invitations = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        await LoadUsersWithRoles();

        try
        {
            var response = await Http.GetFromJsonAsync<List<UserFullResponseDto>>("api/user");
            //var info = response ?? new List<UserInfoResponseDto>();
            var userExists = response.FirstOrDefault(a => a?.UserInfo?.UserId == currentUserId);
            if (userExists == null)
            {
                var newUserInfo = new UserInfoCreateDto
                    {
                        UserId = currentUserId,
                        Name = authState.User.Identity.Name,
                        DailyWorkHours = 0
                    };
                var response2 = await Http.PostAsJsonAsync<UserInfoCreateDto>("api/user/info", newUserInfo);
            }

        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Erro ao buscar utilizador: {ex.Message}");
        }

        await LoadInvitations();
        
        //await LoadData();
    }

    @* // acrecentado para obter userID (user em geral) *@
    private async Task LoadUsersWithRoles()
    {
        var allUsers = UserManager.GetAllUsers();
        var userList = new List<UserWithRoles>();


        foreach (var user in allUsers)
        {
            var roles = await AspNetUserManager.GetRolesAsync(user);
            userList.Add(new UserWithRoles
                {
                    User = user,
                    RoleNames = roles.ToList()
                });
        }

        users = userList;
    }
    @* acrecentado para obter userID (user em geral) *@

    private async Task LoadInvitations()
    {
        invitations = await InvitationService.GetPendingInvitations(currentUserId);
        StateHasChanged();
    }

    private void ShowToast(ToastType type, string message, string title) =>
    messages.Add(
    new ToastMessage
    {
        Type = type,
        Title = title,
        Content = @<div>@message <p>@DateTime.Now</p></div>,
        HelpText = $"{DateTime.Now}",
        AutoHide = true,

    });

}
