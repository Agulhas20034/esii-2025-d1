@page "/test"
@using esii_2025_d1.Dtos.JomDtos
@inject HttpClient Http

<PageTitle>Jom</PageTitle>

<div class="container mt-4">
    @if (joms == null)
    {
        <Spinner Type="SpinnerType.Dots" Class="me-3" Color="SpinnerColor.Primary" />
    }
    else
    {
        <div class="d-flex justify-content-between mb-3">
            <h1>Listar Joms</h1>
            <Button Color="ButtonColor.Primary" @onclick="OnShowAddModalClick">
                <i class="bi bi-plus-circle"></i> Adicionar Jom
            </Button>
        </div>
        
        <Grid TItem="Jom"
              Class="table table-hover table-bordered table-striped"
              Data="@joms"
              AllowPaging="true"
              PageSize="10"
              AllowSorting="true"
              AllowSelection="true"
              SelectionMode="GridSelectionMode.Multiple"
              SelectedItemsChanged="OnSelectedItemsChanged"
              Responsive="true">

            <GridColumns>
                <GridColumn TItem="Jom" HeaderText="ID" PropertyName="Id" SortKeySelector="item => item.Id">
                    @context.Id
                </GridColumn>
                <GridColumn TItem="Jom" HeaderText="Label" PropertyName="Label" SortKeySelector="item => item.Label">
                    @context.Label
                </GridColumn>
                <GridColumn TItem="Jom" HeaderText="Data" PropertyName="Date" SortKeySelector="item => item.Date">
                    @context.Date.ToString("yyyy-MM-dd")
                </GridColumn>
                <GridColumn TItem="Jom" HeaderText="Test Number" PropertyName="TestNumber" SortKeySelector="item => item.TestNumber">
                    @context.TestNumber
                </GridColumn>
                <GridColumn TItem="Jom" HeaderText="Is Done" PropertyName="IsDone" SortKeySelector="item => item.IsDone">
                    @(context.IsDone ? "True" : "False")
                </GridColumn>
                <GridColumn TItem="Jom" HeaderText="Ações">
                        <button class="btn btn-warning btn-sm" @onclick="() => OpenEditModal(context)">
                            <i class="bi bi-pencil-square"></i> Editar
                        </button>
                        <button class="btn btn-danger btn-sm" @onclick="() => OpenDeleteModal(context.Id)">
                            <i class="bi bi-trash"></i> Remover
                        </button>
                </GridColumn>
            </GridColumns>

        </Grid>
        
        <div class="mt-3">
            Selected Items Count: @selectedJoms.Count
        </div>

        <div class="mt-2">
            Selected Joms:
            <ul>
                @foreach (var item in selectedJoms)
                {
                    <li>@item.Label</li>
                }
            </ul>
        </div>
    }

</div>

<!-- Modal de Edit -->
<Modal @ref="editModal" Title="Editar Jom">
    <BodyTemplate>
        <div class="form-group">
            <label>Label</label>
            <TextInput @bind-Value="@editingJomCopy.Label" />
        </div>

        <div class="form-group mt-2">
            <label for="date">Date</label>
            <DateInput TValue="DateOnly" @bind-Value="selectedDate" Placeholder="Enter Date" />
        </div>

        <div>
            <CheckboxInput Label="is done" Id="isDone"  @bind-Value="editingJomCopy.IsDone" />
        </div>

        <div class="form-group mt-2">
            <label for="testNumber">Test Number</label>
            <NumberInput TValue="float" @bind-Value="editingJomCopy.TestNumber" Placeholder="quantidade" />
        </div>
    </BodyTemplate>

    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="OnHideEditModalClick">Fechar</Button>
        <Button Color="ButtonColor.Primary" @onclick="SaveEdit">Salvar alterações</Button>
    </FooterTemplate>
</Modal>

<!-- Modal de delete -->
<Modal @ref="deleteModal" Title="Confirmar Exclusão">
    <BodyTemplate>
        <p>Você tem certeza que deseja excluir este Jom?</p>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="OnHideDeleteModalClick">Cancelar</Button>
        <Button Color="ButtonColor.Danger" @onclick="DeleteJom">Excluir</Button>
    </FooterTemplate>
</Modal>

<!-- Modal de Store  -->
<Modal @ref="addModal" Title="Adicionar Jom">
    <BodyTemplate>
        <div class="form-group">
            <label for="newLabel">Label</label>
            <input type="text" class="form-control" id="newLabel" @bind="newJom.Label" />
        </div>

        <div class="form-group mt-2">
            <label for="newDate">Date</label>
            <DateInput TValue="DateOnly" @bind-Value="selectedDate" Placeholder="Enter Date" />
        </div>
        
        <div class="form-group mt-2">
            <label for="isDone">Is Done</label>
            <CheckboxInput Label="is done" Id="isDone" @bind-Value="newJom.IsDone" />
        </div>
        
        <div class="form-group mt-2">
            <label for="testNumber">Test Number</label>
            <NumberInput TValue="float" @bind-Value="newJom.TestNumber" Placeholder="quantidade" />
        </div>
        
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="OnHideAddModalClick">Fechar</Button>
        <Button Color="ButtonColor.Primary" @onclick="SaveAdd">Salvar</Button>
    </FooterTemplate>
</Modal>

@code {
    
    private Modal editModal = default!;
    private Modal deleteModal = default!;
    private Modal addModal = default!;

    private Jom? editingJom;
    private Jom editingJomCopy = new Jom();
    private Jom newJom = new Jom();
    private int? deletingJomId;

    private List<Jom> joms = new();
    private HashSet<Jom> selectedJoms = new();

    private DateOnly selectedDate = DateOnly.FromDateTime(DateTime.UtcNow);

    protected override async Task OnInitializedAsync()
    {
        await LoadJoms();
    }

    private async Task LoadJoms()
    {
        var response = await Http.GetFromJsonAsync<List<Jom>>("api/Jom");
        joms = response ?? new List<Jom>();
    }

    private Task OnSelectedItemsChanged(HashSet<Jom> items)
    {
        selectedJoms = items is not null && items.Any() ? items : new();
        return Task.CompletedTask;
    }

    private async Task OnShowAddModalClick()
    {
        newJom = new Jom();
        await addModal.ShowAsync();
    }

    private async Task OnHideAddModalClick()
    {
        await addModal.HideAsync();
    }

    private async Task SaveAdd()
    {
        newJom.Date = selectedDate.ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc);

        var jomCreateDto = new JomCreateDto
        {
            Label = newJom.Label,
            IsDone = newJom.IsDone,
            Date = newJom.Date,
            TestNumber = newJom.TestNumber
        };

        var response = await Http.PostAsJsonAsync("api/Jom", jomCreateDto);

        if (response.IsSuccessStatusCode)
        {
            await LoadJoms();
            await addModal.HideAsync();
        }
    }

    private void OpenEditModal(Jom jom)
    {
        editingJom = jom;
        editingJomCopy = new Jom
        {
            Label = jom.Label,
            IsDone = jom.IsDone,
            TestNumber = jom.TestNumber,
            Date = jom.Date
        };
        selectedDate = DateOnly.FromDateTime(jom.Date);
        editModal.ShowAsync();
    }

    private async Task OnHideEditModalClick()
    {
        await editModal.HideAsync();
    }

    private async Task SaveEdit()
    {
        if (editingJomCopy == null)
            return;

        editingJom.Label = editingJomCopy.Label;
        editingJom.Date = selectedDate.ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc);
        editingJom.IsDone = editingJomCopy.IsDone;
        editingJom.TestNumber = editingJomCopy.TestNumber;

        var response = await Http.PutAsJsonAsync($"api/Jom/{editingJom.Id}", editingJom);

        if (response.IsSuccessStatusCode)
        {
            await LoadJoms();
            await editModal.HideAsync();
        }
    }

    private void OpenDeleteModal(int id)
    {
        deletingJomId = id;
        deleteModal.ShowAsync();
    }

    private async Task OnHideDeleteModalClick()
    {
        await deleteModal.HideAsync();
    }

    private async Task DeleteJom()
    {
        if (deletingJomId == null)
            return;

        var response = await Http.DeleteAsync($"api/Jom/{deletingJomId}");

        if (response.IsSuccessStatusCode)
        {
            await LoadJoms();
            await deleteModal.HideAsync();
        }
    }
}


