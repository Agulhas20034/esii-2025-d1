@page "/dashboard"
@using esii_2025_d1.Dtos.JomDtos
@inject HttpClient Http

<PageTitle>Dashboard de Tarefas</PageTitle>

<div class="dashboard-wrapper px-4 py-5">
    <h2 class="mb-4">Bom Dia, Senhor Presidente</h2>
    <h4 class="text-muted">Tem aqui tudo de mão beijada:</h4>

    <p class="text-muted mb-4">
        @DateTime.Now.ToString("dddd, MMMM dd")
    </p>

    <div class="mb-3 d-flex justify-content-end">
        <select class="form-select w-auto" @onchange="e => ChangeSort(e.Value.ToString())">
            <option value="DataAsc">Data ↑</option>
            <option value="DataDesc">Data ↓</option>
            <option value="TestAsc">Nº Teste ↑</option>
            <option value="TestDesc">Nº Teste ↓</option>
        </select>
    </div>

    <div class="mb-3">
        <button class="btn btn-primary" @onclick="ShowAddModal">
            <i class="bi bi-plus-circle"></i> Adicionar nova tarefa
        </button>
    </div>

    @foreach (var state in new[] { "Data ultrapassada", "Pendente", "Quase lá", "Concluído" })
    {
        <div class="card mb-4 shadow-sm rounded">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5>@state</h5>
                <button class="btn btn-link text-primary" @onclick="() => ToggleStateTable(state)">
                    <!-- Ícone de seta de expansão/collapse -->
                    <i class="bi @GetExpandIconClass(state)"></i>
                </button>
            </div>

            <div class="card-body collapse @GetCollapseClass(state)">
                <table class="table table-bordered table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Nome</th>
                            <th>Data</th>
                            <th>Nº Teste</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var jom in joms.Where(j => GetStatusLabel(j) == state))
                        {
                            <tr>
                                <td>@jom.Label</td>
                                <td>@jom.Date.ToString("yyyy-MM-dd")</td>
                                <td>@jom.TestNumber</td>
                                <td><span class="badge bg-@GetStatusBadgeClass(jom)">@GetStatusLabel(jom)</span></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditModal(jom)">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => OpenDeleteModal(jom.Id)">
                                        <i class="bi bi-trash"></i> Remover
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Modal Add -->
    @if (showAddModal)
    {
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content p-3 shadow-lg">
                    <div class="modal-header">
                        <h5 class="modal-title">Nova Tarefa</h5>
                        <button type="button" class="btn-close" @onclick="HideAddModal"></button>
                    </div>
                    <div class="modal-body">
                        <InputText class="form-control mb-2" placeholder="Nome da Tarefa" @bind-Value="newJom.Label" />
                        <InputDate class="form-control mb-2" @bind-Value="newJom.Date" />
                        <InputNumber class="form-control mb-2" @bind-Value="newJom.TestNumber" />
                        <div class="form-check mt-2">
                            <InputCheckbox class="form-check-input" @bind-Value="newJom.IsDone" />
                            <label class="form-check-label ms-2">Concluído</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="HideAddModal">Cancelar</button>
                        <button class="btn btn-primary" @onclick="AddJom">Adicionar</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }
    @if (showEditModal)
    {
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content p-3 shadow-lg">
                    <div class="modal-header">
                        <h5 class="modal-title">Editar Tarefa</h5>
                        <button type="button" class="btn-close" @onclick="HideEditModal"></button>
                    </div>
                    <div class="modal-body">
                        <InputText class="form-control mb-2" placeholder="Nome da Tarefa" @bind-Value="selectedJom.Label" />
                        <InputDate class="form-control mb-2" @bind-Value="selectedJom.Date" />
                        <InputNumber class="form-control mb-2" @bind-Value="selectedJom.TestNumber" />
                        <div class="form-check mt-2">
                            <InputCheckbox class="form-check-input" @bind-Value="selectedJom.IsDone" />
                            <label class="form-check-label ms-2">Concluído</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="HideEditModal">Cancelar</button>
                        <button class="btn btn-primary" @onclick="UpdateJom">Guardar</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }

    @if (showDeleteModal)
    {
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content p-3 shadow-lg">
                    <div class="modal-header">
                        <h5 class="modal-title">Remover Tarefa</h5>
                        <button type="button" class="btn-close" @onclick="HideDeleteModal"></button>
                    </div>
                    <div class="modal-body">
                        <p>Tem a certeza que quer remover esta tarefa?</p>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="HideDeleteModal">Cancelar</button>
                        <button class="btn btn-danger" @onclick="DeleteJom">Remover</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }
</div>

@code {
    enum SortOption
    {
        DataAsc,
        DataDesc,
        TestAsc,
        TestDesc
    }

    SortOption currentSort = SortOption.DataAsc;

    List<Jom> joms = new List<Jom>();
    Jom newJom = new();
    Jom selectedJom = new();
    int deleteJomId;

    bool showAddModal = false;
    bool showEditModal = false;
    bool showDeleteModal = false;

    // Controlar a visibilidade de cada categoria
    bool isPendingVisible = false;
    bool isAlmostVisible = false;
    bool isDoneVisible = false;
    bool isOverdueVisible = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadJoms();
        ApplySorting();
    }

    async Task LoadJoms()
    {
        joms = await Http.GetFromJsonAsync<List<Jom>>("api/jom");
    }

    void ShowAddModal() => showAddModal = true;

    void HideAddModal()
    {
        showAddModal = false;
        newJom = new();
    }

    async Task AddJom()
    {
        if (string.IsNullOrEmpty(newJom.Label) || newJom.TestNumber <= 0)
        {
            // Display validation error here
            return;
        }

        await Http.PostAsJsonAsync("api/jom", newJom);
        await LoadJoms();
        HideAddModal();
    }

    void OpenEditModal(Jom jom)
    {
        selectedJom = new Jom
            {
                Id = jom.Id,
                Label = jom.Label,
                Date = jom.Date,
                IsDone = jom.IsDone,
                TestNumber = jom.TestNumber
            };
        showEditModal = true;
    }

    void HideEditModal()
    {
        showEditModal = false;
        selectedJom = new();
    }

    async Task UpdateJom()
    {
        if (string.IsNullOrEmpty(selectedJom.Label) || selectedJom.TestNumber <= 0)
        {
            // Display validation error here
            return;
        }

        await Http.PutAsJsonAsync($"api/jom/{selectedJom.Id}", selectedJom);
        await LoadJoms();
        HideEditModal();
    }

    void OpenDeleteModal(int id)
    {
        deleteJomId = id;
        showDeleteModal = true;
    }

    void HideDeleteModal()
    {
        showDeleteModal = false;
        deleteJomId = 0;
    }

    async Task DeleteJom()
    {
        await Http.DeleteAsync($"api/jom/{deleteJomId}");
        await LoadJoms();
        HideDeleteModal();
    }

    string GetStatusLabel(Jom jom)
    {
        var today = DateTime.Today;

        if (!jom.IsDone && jom.Date < today)
            return "Data ultrapassada";

        if (!jom.IsDone && (jom.Date - today).TotalDays <= 3 && (jom.Date - today).TotalDays >= 0)
            return "Quase lá";

        return jom.IsDone ? "Concluído" : "Pendente";
    }

    string GetStatusBadgeClass(Jom jom)
    {
        var today = DateTime.Today;

        if (!jom.IsDone && jom.Date < today)
            return "danger";

        if (!jom.IsDone && (jom.Date - today).TotalDays <= 3 && (jom.Date - today).TotalDays >= 0)
            return "warning";

        return jom.IsDone ? "success" : "secondary";
    }

    void ChangeSort(string sortOrder)
    {
        currentSort = Enum.TryParse(sortOrder, out SortOption sortOption) ? sortOption : SortOption.DataAsc;
        ApplySorting();
    }

    void ApplySorting()
    {
        switch (currentSort)
        {
            case SortOption.DataAsc:
                joms = joms.OrderBy(j => j.Date).ToList();
                break;
            case SortOption.DataDesc:
                joms = joms.OrderByDescending(j => j.Date).ToList();
                break;
            case SortOption.TestAsc:
                joms = joms.OrderBy(j => j.TestNumber).ToList();
                break;
            case SortOption.TestDesc:
                joms = joms.OrderByDescending(j => j.TestNumber).ToList();
                break;
        }
    }

    void ToggleStateTable(string state)
    {
        if (state == "Pendente")
            isPendingVisible = !isPendingVisible;
        else if (state == "Quase lá")
            isAlmostVisible = !isAlmostVisible;
        else if (state == "Concluído")
            isDoneVisible = !isDoneVisible;
        else if (state == "Data ultrapassada")
            isOverdueVisible = !isOverdueVisible;
    }

    string GetCollapseClass(string state)
    {
        if (state == "Pendente" && isPendingVisible ||
            state == "Quase lá" && isAlmostVisible ||
            state == "Concluído" && isDoneVisible ||
            state == "Data ultrapassada" && isOverdueVisible)
            return "show";

        return string.Empty;
    }

    string GetExpandIconClass(string state)
    {
        return (state == "Pendente" && isPendingVisible ||
                state == "Quase lá" && isAlmostVisible ||
                state == "Concluído" && isDoneVisible ||
                state == "Data ultrapassada" && isOverdueVisible)
            ? "bi-chevron-up"
            : "bi-chevron-down";
    }
}
